# API Keys
OPENAI_API_KEY=your_openai_api_key_here
# Optional override; defaults to OPENAI_API_KEY
LLM_API_KEY=
SERPAPI_API_KEY=your_serpapi_key_here

# LLM Configuration
LLM_MODEL=gpt-4.1-mini
PROMPT_VERSION=v1
LLM_CONTEXT_WINDOW=16000
RESPONSE_TOKEN_BUDGET=2000
MAX_HISTORY_TOKENS=3000
MAX_RETRIEVAL_TOKENS=6000
MAX_SUMMARY_TOKENS=1500
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSION=3072

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Qdrant Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=knowledge_base

# TTS Configuration
# Supported services: coqui, google, azure, elevenlabs
TTS_SERVICE=coqui
TTS_API_KEY=your_tts_api_key_here
COQUI_MODEL=tts_models/multilingual/multi-dataset/xtts_v2
COQUI_SPEAKER_WAV=/absolute/path/to/reference.wav
COQUI_LANGUAGE=en

# STT Configuration
# Supported services: google, azure, whisper
STT_SERVICE=whisper
STT_API_KEY=your_stt_api_key_here

# Application settings
LOG_LEVEL=INFO
MAX_CONTEXT_LENGTH=5
RAG_CANDIDATE_LIMIT=20
RAG_MIN_SCORE=0.45
RAG_DENSE_WEIGHT=0.65
MEMORY_RECENT_MESSAGES=10
MEMORY_SUMMARY_TRIGGER=16
MEMORY_TTL_SECONDS=2592000
WEBSOCKET_SYNTHESIZE_AUDIO=false
